{
  // "duolingo" or "chesscom"
  "service": "chesscom",

  "interval_ms": 10,
  "web_port": 5873,
  "enable_web": false,

  "max_error_threshold": 3800.0,
  "stability_threshold": 2,

  "auto_play": true,
  "humanize": true,

  "move_delay_min_ms": 500,
  "move_delay_max_ms": 1500,

  "tap_delay_min_ms": 140,
  "tap_delay_max_ms": 280,

  "duolingo": {
    "figures_dir": "./Figures/Duolingo",
    "game_type": "People",
    "y_ratio_oscar": 0.35625,
    "y_ratio_people": 0.336,
    "auto_claim_xp": true,
    "auto_start_game": true
  },

  "chesscom": {
    "figures_dir": "./Figures/ChessCom",
    "y_ratio": 0.16875,
    "auto_start_game": true,
    "auto_dismiss": true
  }
}
